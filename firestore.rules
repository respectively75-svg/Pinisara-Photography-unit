rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "respectively75@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['student', 'parent', 'photographer', 'editor', 'admin'];
    }

    function isValidPhoto(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 200 &&
             data.originalUrl is string && data.originalUrl.size() <= 500 &&
             data.webUrl is string && data.webUrl.size() <= 500 &&
             data.photographerName is string && data.photographerName.size() <= 100 &&
             data.category is string && data.category.size() <= 50;
    }

    function isValidEvent(data) {
      return data.id is string &&
             data.title is string && data.title.size() <= 150 &&
             data.category is string && data.category.size() <= 50 &&
             data.coverPhotoUrl is string && data.coverPhotoUrl.size() <= 500;
    }

    // User Public Profiles
    match /users/{userId} {
      allow read: if true; // Public for photographer attribution
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    // User Private Settings & PII
    match /users/{userId}/private/{privateId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Events (Public Galleries, Games, Ceremonies)
    match /events/{eventId} {
      allow read: if true;
      allow create: if (isAdmin() || isSignedIn()) && isValidEvent(request.resource.data) && isValidId(eventId);
      allow update: if (isAdmin() || isSignedIn()) && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    // Photos Collection
    match /photos/{photoId} {
      allow read: if true; // Public high-res gallery browsing
      allow create: if (isAdmin() || isSignedIn()) && isValidPhoto(request.resource.data) && isValidId(photoId);
      allow update: if (isAdmin() || isSignedIn()) && isValidPhoto(request.resource.data);
      allow delete: if isAdmin();

      // Subcollection for Favorites
      match /favorites/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidId(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Public Live Notifications & Game Alerts
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
